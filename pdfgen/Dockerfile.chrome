FROM node:20

RUN apt-get -qq update && \
    apt-get -qq install chromium && \
    rm -rf /var/lib/apt/lists/*

ENV NODE_OPTIONS=--openssl-legacy-provider
WORKDIR /usr/src/app
RUN npm i puppeteer

ADD sh.js /usr/src/app/
WORKDIR /out
CMD sh -c 'python3 -m http.server 8000 & node /usr/src/app/sh.js'
